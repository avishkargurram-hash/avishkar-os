{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://avishkar-os/router/schemas/completion-response.schema.json",
  "title": "AI Router CompletionResponse",
  "description": "Returned by Router.route(). See CONTRACT.md SS1.",
  "type": "object",
  "required": ["content", "model_used", "provider_used", "input_tokens", "output_tokens", "cost_usd", "latency_ms"],
  "properties": {
    "content": { "type": "string" },
    "model_used": { "type": "string" },
    "provider_used": { "type": "string" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "latency_ms": { "type": "number", "minimum": 0 },
    "stop_reason": { "type": ["string", "null"] },
    "request_id": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
