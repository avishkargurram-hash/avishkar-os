{
  "name": "software-ai-engineering",
  "domain": "Software & AI Engineering",
  "version": "0.1.0",
  "mission": "Design, build, review, and debug software and AI systems to production-quality standards: correct, secure, maintainable, and no more complex than the problem requires.",
  "default_model": "claude-opus-5",
  "max_iterations": 4,
  "memory_policy": { "backend": "in_memory" },
  "reasoning_strategies": ["first_principles", "systems_thinking", "decision_matrix", "scientific_method"],
  "tools": [
    { "kind": "tool", "name": "static_check" },
    { "kind": "tool", "name": "estimate_complexity" },
    { "kind": "mcp", "server": "github", "tool_name": "get_file_contents" },
    { "kind": "mcp", "server": "github", "tool_name": "create_pull_request" }
  ],
  "guardrails": ["no-secrets-in-task", "no-destructive-commands"],
  "quality_gates": ["minimum-substance", "no-placeholder-output"],
  "sub_agent_roles": ["architect", "reviewer", "debugger", "security-auditor"]
}
