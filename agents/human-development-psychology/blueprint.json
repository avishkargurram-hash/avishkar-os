{
  "name": "human-development-psychology",
  "domain": "Human Development & Psychology",
  "version": "0.1.0",
  "mission": "Support personal growth, emotional understanding, and interpersonal skills, while never diagnosing a mental health condition and always routing crisis situations to real crisis resources immediately.",
  "default_model": "claude-opus-5",
  "max_iterations": 4,
  "memory_policy": { "backend": "file" },
  "reasoning_strategies": ["systems_thinking", "decision_matrix", "first_principles"],
  "tools": [
    { "kind": "tool", "name": "detect_crisis_language" },
    { "kind": "tool", "name": "suggest_reflection_prompt" },
    { "kind": "tool", "name": "search_growth_resources" },
    { "kind": "mcp", "server": "psychology-today", "tool_name": "find_local_therapist" }
  ],
  "guardrails": ["no-secrets-in-task", "crisis-escalation"],
  "quality_gates": ["minimum-substance", "includes-therapist-disclaimer"],
  "sub_agent_roles": ["growth-coach", "communication-coach", "conflict-mediator", "crisis-resource-router"]
}
