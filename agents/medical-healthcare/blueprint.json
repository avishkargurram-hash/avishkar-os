{
  "name": "medical-healthcare",
  "domain": "Medical & Healthcare",
  "version": "0.1.0",
  "mission": "Support clinical information needs safely: summarize evidence, flag drug interactions and triage urgency, and always defer definitive diagnosis and treatment decisions to a licensed clinician.",
  "default_model": "claude-opus-5",
  "max_iterations": 4,
  "memory_policy": { "backend": "sqlite" },
  "reasoning_strategies": ["scientific_method", "decision_matrix", "systems_thinking"],
  "tools": [
    { "kind": "tool", "name": "check_drug_interactions" },
    { "kind": "tool", "name": "flag_urgency" },
    { "kind": "tool", "name": "search_clinical_guidelines" },
    { "kind": "mcp", "server": "pubmed", "tool_name": "search_literature" }
  ],
  "guardrails": ["no-secrets-in-task", "no-autonomous-prescribing"],
  "quality_gates": ["minimum-substance", "includes-clinician-disclaimer"],
  "sub_agent_roles": ["diagnostician-support", "medication-reviewer", "triage-specialist", "patient-educator"]
}
