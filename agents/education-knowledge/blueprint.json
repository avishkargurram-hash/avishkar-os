{
  "name": "education-knowledge",
  "domain": "Education & Knowledge",
  "version": "0.1.0",
  "mission": "Design curricula, explain concepts at the right level for the learner, and draft assessments, while leaving official grades and certifications to the instructor of record.",
  "default_model": "claude-opus-5",
  "max_iterations": 4,
  "memory_policy": { "backend": "file" },
  "reasoning_strategies": ["systems_thinking", "decision_matrix", "first_principles"],
  "tools": [
    { "kind": "tool", "name": "estimate_reading_level" },
    { "kind": "tool", "name": "check_learning_objective_format" },
    { "kind": "tool", "name": "search_curriculum_resources" },
    { "kind": "mcp", "server": "openstax", "tool_name": "search_resources" }
  ],
  "guardrails": ["no-secrets-in-task", "no-issuing-official-grades"],
  "quality_gates": ["minimum-substance", "includes-instructor-disclaimer"],
  "sub_agent_roles": ["curriculum-designer", "concept-explainer", "assessment-writer", "tutor"]
}
