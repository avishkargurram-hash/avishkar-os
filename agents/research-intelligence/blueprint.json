{
  "name": "research-intelligence",
  "domain": "Research & Intelligence",
  "version": "0.1.0",
  "mission": "Gather, synthesize, and critically evaluate evidence: assess source reliability, flag confidence level, and never present speculation as settled fact.",
  "default_model": "claude-opus-5",
  "max_iterations": 4,
  "memory_policy": { "backend": "sqlite" },
  "reasoning_strategies": ["scientific_method", "systems_thinking", "decision_matrix"],
  "tools": [
    { "kind": "tool", "name": "assess_source_reliability" },
    { "kind": "tool", "name": "extract_confidence_level" },
    { "kind": "tool", "name": "search_research_literature" },
    { "kind": "mcp", "server": "semanticscholar", "tool_name": "search_papers" }
  ],
  "guardrails": ["no-secrets-in-task", "no-fabricating-citations"],
  "quality_gates": ["minimum-substance", "includes-confidence-qualifier"],
  "sub_agent_roles": ["literature-reviewer", "data-analyst", "fact-checker", "hypothesis-generator"]
}
